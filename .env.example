# ---------- Supabase (Project Settings > API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do app (sem barra no final)
NEXT_PUBLIC_APP_URL=https://app.fluxa.com.br

# ---------- IA: OpenAI (principal) ----------
# Chave da API em platform.openai.com/api-keys (aceita várias separadas por vírgula).
OPENAI_API_KEY=
# Opcional (estes já são os padrões):
OPENAI_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst
# Raciocínio do texto: none | low | medium | high. Qualidade do fundo: low | medium | high
OPENAI_REASONING=low
OPENAI_IMAGE_QUALITY=medium

# ---------- IA: Gemini (reserva, opcional) ----------
# Se a OpenAI falhar, o sistema tenta todos os modelos do Gemini. Deixe vazio para usar só a OpenAI.
# Pode colocar várias chaves separadas por vírgula: o sistema reveza e pula as que estourarem o limite.
GEMINI_API_KEYS=
# Opcional: modelos preferidos (vírgula). O sistema já tenta todos os outros sozinho se estes falharem.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ---------- Pagar.me (grupo Stone) — Configurações > Chaves ----------
PAGARME_SECRET_KEY=sk_
NEXT_PUBLIC_PAGARME_PUBLIC_KEY=pk_
# Usuário e senha que você cadastra no webhook do Pagar.me (autenticação básica)
PAGARME_WEBHOOK_USER=fluxa
PAGARME_WEBHOOK_PASSWORD=

# ---------- Integração com o n8n interno da Fluxa ----------
# Mesmo valor do campo saas_token no Config do fluxo interno
INTERNAL_API_TOKEN=
# Webhook do n8n que avisa você no WhatsApp (A8 · Webhook SaaS do fluxo interno)
FLUXA_N8N_WEBHOOK_URL=

# ---------- Nota fiscal (NFS-e) ----------
# Chave para cifrar os certificados A1 das clínicas (texto longo e aleatório). Opcional: sem ela, usa a SUPABASE_SERVICE_ROLE_KEY.
# Defina antes de as clínicas enviarem certificados (trocar depois obriga a enviar de novo).
NFSE_SECRET=

# Protege a rota de cron (Vercel envia Authorization: Bearer CRON_SECRET)
CRON_SECRET=
